process {

	resourceLimits = [
	    cpus: params.max_cpus,
	    memory: params.max_memory,
	    time: params.max_time
	]

    cpus   = {  2    * task.attempt   }
    memory = {  30.GB * task.attempt }
    time   = {  4.h  * task.attempt   }

    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 5
    maxErrors     = '-1'

// ---------------------------------------------------------------------------
// F17. These were sized by guess and over-requested by one to three orders of
// magnitude, which on a shared cluster costs throughput rather than money: a
// 256 GB node could host two filterReads tasks instead of dozens.
//
// Measured from the v0.0.1 Mutographs CRC run (pksProfiler_analysis/v0.0.1/
// mutographs_crc/trace.txt), peak RSS across completed tasks:
//
//   process            n      median      max      was asking
//   extractReads    2043     0.04 GB  0.04 GB          64 GB
//   filterReads     1167      1.2 GB   1.3 GB         128 GB
//   mapReads         517     11.3 GB  11.6 GB          64 GB
//   pksProfilerAlign 219      0.1 GB   1.7 GB         128 GB
//   plotPKS           82      0.1 GB   0.1 GB         100 GB
//
// Requests below are comfortably above the observed maximum, and every one keeps
// its `* task.attempt` multiplier, so a task that genuinely needs more gets it on
// retry rather than being capped here. mapReads holds the largest floor because
// minimap2 loads an 8.6 GB index.
//
// The mag_* labels are untouched: the metagenome lane did not run in that cohort,
// so there is no measurement to size them from.
// ---------------------------------------------------------------------------
    withLabel:process_low {
        cpus   = {  2     * task.attempt }
        memory = {   8.GB * task.attempt }
        time   = {   4.h  * task.attempt }
    }
    withLabel:process_medium {
        cpus   = {  4     * task.attempt }
        memory = { 16.GB  * task.attempt }
        time   = {  8.h   * task.attempt }
    }
    withLabel:process_high_disk {
        cpus   = {  4     * task.attempt }
        memory = { 64.GB  * task.attempt }
        time   = { 24.h   * task.attempt }
        disk   = { 100.GB * task.attempt }
    }
    withLabel:extract_reads {
        // measured 0.04 GB peak across 2,043 tasks; 4 GB is ~100x headroom
        cpus   = 8
        memory = { 4.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withLabel:filter_reads {
        // measured 1.3 GB peak across 1,167 tasks; slowest was 97 min
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
	withLabel:map_reads {
	    // measured 11.6 GB peak; minimap2 holds an 8.6 GB index, so this floor stays high
	    cpus   = 16
	    memory = { 24.GB * task.attempt }
	    time   = { 8.h * task.attempt }
	}
	withLabel:pks_align {
	    // measured 1.7 GB peak across 219 tasks
	    cpus   = 4
	    memory = { 8.GB * task.attempt }
	    time   = { 8.h * task.attempt }
	}
	withLabel:pks_hmm {
	    // no measurement: the HMM lane did not run in the cohort above, so this is
	    // reduced but left generous rather than tuned
	    cpus   = 8
	    memory = { 32.GB * task.attempt }
	    time   = { 16.h * task.attempt }
	}
	withLabel:mag_assembly {
	    cpus   = 16
	    memory = { 64.GB * task.attempt }
	    time   = { 12.h * task.attempt }
	}
	withLabel:targeted_recruit {
	    cpus = 8
	    memory = 32.GB
	    time = 8.h
	}
	withLabel:targeted_assembly {
	    cpus = 16
	    memory = 64.GB
	    time = 12.h
	}
	withLabel:mag_binning {
	    cpus   = 8
	    memory = { 32.GB * task.attempt }
	    time   = { 4.h * task.attempt }
	}
	withLabel:mag_gtdbtk {
	    cpus   = 16
	    memory = { 200.GB * task.attempt }
	    time   = { 24.h * task.attempt }
	}
	withLabel:mag_prophage {
	    cpus   = 8
	    memory = { 64.GB * task.attempt }
	    time   = { 12.h * task.attempt }
	}
	withLabel:mag_hmm {
	    cpus   = 8
	    memory = { 16.GB * task.attempt }
	    time   = { 4.h * task.attempt }
	}

	// One sample failing must not stop the cohort steps from ever launching. The
	// default strategy is 'finish', under which Nextflow submits no NEW tasks after
	// an error -- and every cohort table is a new task fed by .collect(). A single
	// sample hitting the time cap therefore took the whole batch's QC summary and
	// gene counts with it. Scoped to the per-sample lane: cohort processes keep
	// 'finish', because their failure is not something to carry on past.
	withName: 'extractReads|filterReads|mapReads|pksProfiler_align|pksProfiler_hmm' {
	    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : params.sample_failure_strategy }
	}
}

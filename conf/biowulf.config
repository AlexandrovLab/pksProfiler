/*
 * NIH Biowulf Slurm profile.
 *
 * The default norm partition and conservative scheduler polling follow NIH
 * guidance. Override biowulf_lscratch_gb if a sample needs more local disk.
 */

params.biowulf_lscratch_gb = 200

executor {
    name = 'slurm'
    queueSize = 200
    pollInterval = '2 min'
    queueStatInterval = '2 min'
    submitRateLimit = '1 sec'
}

process {
    executor = 'slurm'
    queue = 'norm'
    clusterOptions = { "--gres=lscratch:${params.biowulf_lscratch_gb}" }
}

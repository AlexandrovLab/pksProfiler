/*
 * NIH Biowulf Slurm profile.
 *
 * The default norm partition and conservative scheduler polling follow NIH
 * guidance. Override biowulf_lscratch_gb if a sample needs more local disk.
 *
 * F17 (Ludmil, 19/23 Sep reports): queueStatInterval and submitRateLimit are NIH's
 * documented 5 min and 6/1min (they were 2 min and 1 sec). pollInterval stays at
 * NIH's 2 min.
 */

params.biowulf_lscratch_gb = 200

executor {
    name = 'slurm'
    queueSize = 200
    pollInterval = '2 min'
    queueStatInterval = '5 min'
    submitRateLimit = '6/1min'
}

process {
    executor = 'slurm'
    queue = 'norm'
    clusterOptions = { "--gres=lscratch:${params.biowulf_lscratch_gb}" }
}

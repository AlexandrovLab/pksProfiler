/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    pksProfiler Nextflow configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defaults for all compute environments. Pipeline parameters are declared in main.nf.
----------------------------------------------------------------------------------------
*/

manifest {
    name            = 'AlexandrovLab/pksProfiler'
    author          = 'Alexandrov Lab, University of California San Diego'
    homePage        = 'https://github.com/AlexandrovLab/pksProfiler'
    description     = 'Detection, quantification and genome-resolved analysis of the pks (colibactin) island'
    mainScript      = 'main.nf'
    version         = '1.0.0-rc2'
    // Enforced, not merely documented: Nextflow refuses to run on an older release.
    nextflowVersion = '>=24.10.0'
}

params {
    // Resource ceilings applied by conf/base.config via resourceLimits.
    max_memory = '1.TB'
    max_cpus   = 64
    max_time   = '240.h'

    // Declared here as well as in main.nf so the report/timeline/trace paths below can
    // follow --outdir. Script-level params are the lowest precedence, so main.nf
    // repeating the same default changes nothing.
    outdir = "${launchDir}/results"

    // Same reasoning, and the actual cause of m-1 (Ludmil's email: "Github shows your
    // tests failing"): conda.cacheDir below reads params.conda_cache_dir at config-
    // evaluation time, before main.nf's own `params.conda_cache_dir = null` has run.
    // Nextflow 26.x resolves the reference to null leniently; 24.10.0 -- the exact
    // floor this manifest declares and the exact version CI pins -- refuses to compile
    // at all: "Unknown config attribute `params.conda_cache_dir`". Reproduced directly
    // against Nextflow 24.10.0 on the pre-fix baseline commit (870e4fa); this one
    // declaration is the fix.
    conda_cache_dir = null
    // Read by workflow.onComplete below, so declared here for the same reason.
    tool_version_check = 'strict'
}

includeConfig 'conf/base.config'

workDir = './work'

// Per-process environments are built from conda_envs/. No process declares a container,
// so the container profiles that ship with the nf-core template have been removed rather
// than left in place to fail: see README, "Quick start".
conda.enabled = true

// Pin the environment cache outside the work directory. Nextflow's default is
// <work-dir>/conda, so a per-batch work dir that gets deleted on success rebuilds
// every environment next time. The same resolved path goes to the provenance
// finaliser below -- when the two disagreed, the 2026-09-21 smoke test reported
// "conda environments were not found" and recorded no tool versions.
conda.cacheDir = params.conda_cache_dir ?: "${launchDir}/conda_cache"

// Make the task's conda environment win on PATH. Nextflow activates it with
// `source <base>/bin/activate <env>`, and activation swaps the base bin entry for the
// env's IN PLACE: anything the launching shell had ahead of the conda base on PATH still
// shadows the env. Found by tests/check_mode_execution.sh on TSCC (29 Sep): a user
// minimap2 2.24 ahead of anaconda3/bin ran every host-depletion pass instead of the
// pinned 2.31 (it rejected -j), and samtools/bowtie2/featureCounts came from whatever
// env was active at launch. Putting the base bin first before activation puts the env
// bin first after it. beforeScript runs just before the activation line.
process.beforeScript = 'if command -v conda >/dev/null 2>&1; then export PATH="$(conda info --base)/bin:$PATH"; fi'

// Nextflow's own artefacts are the third output tree, alongside by_sample/ and cohort/.
// overwrite = true because a resumed run that reuses a report name otherwise dies with
// FileAlreadyExistsException at the very end, after every task has already succeeded --
// which is exactly how the 2026-09-12 metagenome_screen run ended.
report   { enabled = true; overwrite = true; file = "${params.outdir}/runs/report.html"   }
timeline { enabled = true; overwrite = true; file = "${params.outdir}/runs/timeline.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/runs/trace.txt"     }
// Nextflow's default trace columns plus workdir: F16's runtime tool-version records sit in
// each task's work dir (.tool_versions.tsv, lib/ToolVersions.groovy), and this is how
// scripts/finalize_provenance.py finds them -- cached tasks included -- without a walk
// of the work tree.
trace.fields = 'task_id,hash,native_id,name,status,exit,submit,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar,workdir'

// The second half of the equivalence record (F16). The workflow body writes the record
// at launch; this fills in the outcome and the output checksums.
//
// It lives here because Nextflow's script parser does not allow a top-level
// `workflow.onComplete` block, and it shells out because classes in lib/ are not
// visible to the config parser. Putting the logic in Python rather than inlining it
// here also makes it testable -- see tests/test_provenance_record.py.
//
// Fires on failure too, so a failed run's record says `failed` rather than staying at
// `started`.
workflow.onComplete = {
    try {
        def command = [
            'python3', "${projectDir}/scripts/finalize_provenance.py",
            '--outdir',      "${params.outdir}",
            '--runs-dir',    "${params.outdir}/runs",
            '--cohort-dir',  "${params.outdir}/cohort",
            '--session',     "${workflow.sessionId}",
            '--success',     "${workflow.success}",
            '--exit-status', "${workflow.exitStatus}",
            '--duration',    "${workflow.duration}",
            '--error-message', (workflow.errorMessage ?: ''),
            '--trace-file',  "${params.outdir}/runs/trace.txt",
            // Authoritative task counts, straight from the session. The per-process
            // table is parsed from trace.txt, which onComplete can reach before the
            // trace observer has flushed it -- these do not depend on that.
            '--succeeded', "${workflow.stats.succeededCount}",
            '--cached',    "${workflow.stats.cachedCount}",
            '--failed',    "${workflow.stats.failedCount}",
            '--ignored',   "${workflow.stats.ignoredCount}",
            // Nextflow puts conda environments in <workDir>/conda unless cacheDir is
            // pinned; the report reads their conda-meta to record installed versions.
            '--conda-cache-dir', (params.conda_cache_dir ?: "${workflow.launchDir}/conda_cache"),
            // F16: how a runtime tool-version problem is reported (strict | warn).
            '--tool-version-check', "${params.tool_version_check ?: 'strict'}",
        ]
        def process = command.execute()
        process.waitForProcessOutput(System.out, System.err)
    }
    catch (Exception problem) {
        // A provenance failure must not mask the run's own outcome.
        System.err.println("WARN: could not finalise the provenance record: ${problem.message}")
    }
}

executor {
    name = 'local'
}

profiles {

    // --- schedulers ---
    tscc     { includeConfig 'conf/tscc.config'     }
    slurm    { includeConfig 'conf/slurm.config'    }
    biowulf  { includeConfig 'conf/biowulf.config'  }
    pbspro   { includeConfig 'conf/pbspro.config'   }
    lsf      { includeConfig 'conf/lsf.config'      }
    sge      { includeConfig 'conf/sge.config'      }

    // --- local execution ---
    local {
        executor.name = 'local'
    }

    // --- environment management ---
    conda {
        conda.enabled = true
    }
    mamba {
        conda.enabled  = true
        conda.useMamba = true
    }
}

// A `test` profile is not provided yet: the repository ships no sequencing test data, so
// there is nothing for it to run against. Do not re-add a commented-out placeholder --
// it reads as a feature that exists.
